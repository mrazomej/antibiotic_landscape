#This file exists to stop the addition of forbidden files into the github
#respository #Such forbidden files are images, movies, and various dotfiles
#(such as .DS_store on mac). This .gitignore file will be common to all
#repositories and should be the first file that is committed.

#Ignore trash dotfiles.
*.DS_store
*.vscode/

#Ignore shortcuts (on Windows)
*.lnk

#Ignore latex garbage.
*.swp
*.log
*.aux
*.bbl
*.fls
*.fdb_latexmk
*.dvi
*.bcf
*.run.xml
*.toc
*blx.bib

#Ignore images
*.jpg
*.tif*
*.eps
*.ai
*.svg
*.bmp
*.hdr

#Ignore movies and audio
*.mp4
*.mov
*.avi
*.wav
*.mp3

#Ignore Microsoft, Apple, and PDF documents.
*.ppt*
*.doc*
*.xsl*
*.numbers
*.pages
*.key
*.pdf

#Ignore LaTeX helper files
*.blg
*.out
*.synctex.gz

#Ignore various code garbage.
*.pyc
*.ipynb_checkpoints*
**/.ipynb_checkpoints/
*pycache*
pyCRNevo.egg-info/

# Ignore pickle files
*.pkl
*.dill

# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov

# Files generated by invoking Julia with --track-allocation
*.jl.mem

# System-specific files and directories generated by the BinaryProvider and BinDeps packages
# They contain absolute paths specific to the host computer, and so should not be committed
deps/deps.jl
deps/build.log
deps/downloads/
deps/usr/
deps/src/

# Build artifacts for creating documentation generated by the Documenter package
docs/build/
docs/site/

# File generated by Pkg, the package manager, based on a corresponding Project.toml
# It records a fixed state of all packages used by the project. As such, it should not be
# committed for packages, but should be committed for applications that require a static
# environment.
Manifest.toml

# Files to ignore
*jld2

# Directories to ignore
*/*/tmp/*
doc/*_files/*
doc/_*.html
doc/_*.pdf
code/analysis/*/output/
code/processing/*/output/
code/processing/*/*/output/
code/exploratory/output/
code/fig/output/
data/*
output/*
fig/*

# =============================================================================
# Quarto-generated files (paper/)
# =============================================================================
# HTML output files (we use docs/ for GitHub Pages instead)
paper/*.html
paper/**/*.html

# Quarto HTML asset directories (libs, figures, etc.)
paper/*_files/
paper/**/*_files/

# Quarto website output
paper/_output/
paper/site_libs/

# Review folder - only track source files (.qmd, template.tex, _preamble.tex, etc.)
# Ignore generated output files
paper/_prxlife_reviews/prxlife_reviews.tex
paper/_prxlife_reviews/prxlife_reviews02.tex
paper/_prxlife_reviews/*.pdf
paper/_prxlife_reviews/_output/

# Code notebooks - ignore generated HTML/assets (keep .qmd and .tex)
paper/code/*.html

# Data files in paper/code that can be regenerated
paper/code/iwasawa_data/
paper/code/sim_metropolis_dynamics/*.jld2
paper/code/sim_metropolis_dynamics/*_state/

/.luarc.json
